{
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/rex/saved_models/**": true,
    "**/rex/models/**": true,
    "**/public/datasets/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/rex/saved_models": true,
    "**/.next": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/rex/saved_models": true,
    "**/public/datasets": true,
    "**/package-lock.json": true,
    "**/uv.lock": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "search.useIgnoreFiles": true,
  "git.untrackedChanges": "hidden",
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none"
}
